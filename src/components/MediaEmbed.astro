---
import { embedUrl, type EmbedProvider } from '../utils/media';
interface Props { provider: EmbedProvider; url: string; title: string; loading?: 'eager' | 'lazy' }
const { provider, url, title, loading = 'lazy' } = Astro.props;
const source = embedUrl(provider, url);
---
{source && <iframe src={source} title={title} loading={loading} allow="encrypted-media; fullscreen; picture-in-picture" sandbox="allow-scripts allow-same-origin allow-popups" class:list={['media-embed', provider]}></iframe>}
