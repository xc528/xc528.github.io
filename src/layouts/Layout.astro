---
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string }
const {
  title = 'Music, sound & everything in between.',
  description = 'Rhan Chen — Toronto-based musician, mastering engineer and creative production professional.',
  image = 'images/pipa-monochrome.jpg',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#141414"/>
    <title>{title} — Rhan Chen</title><meta name="description" content={description}/>
    <meta property="og:title" content={`${title} — Rhan Chen`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
    {canonical && <><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(base + image, Astro.site).href}/></>}
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans:wght@400;450;500;600&family=Syne:wght@600;700;800&display=swap" rel="stylesheet"/>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="wordmark" href={base} aria-label="Rhan Chen home"><span class="logo-mark" aria-hidden="true">r/c</span><span class="wordmark-caption">RHAN CHEN<br/><small>Independent frequencies</small></span></a>
      <nav aria-label="Main navigation">{[['Work', 'work/'], ['About', 'about/']].map(([label, path], i) => <a href={base + path} aria-current={Astro.url.pathname.startsWith(base + path) ? 'page' : undefined}><span class="nav-number" aria-hidden="true">0{i + 1}</span>{label}<span aria-hidden="true">↗</span></a>)}</nav>
    </header>
    <main id="main"><slot/></main>
    <footer class="footer minimal-footer">
      <div class="wrap"><span>© {new Date().getFullYear()} Rhan Chen</span><nav aria-label="Footer navigation"><a href={base}>Home</a><a href={`${base}#mastering`}>Mastering</a><a href={`${base}research/`}>Research & Technology</a><a href={`${base}contact/`}>Contact</a></nav></div>
    </footer>
  </body>
</html>
