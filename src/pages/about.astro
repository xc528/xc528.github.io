---
import Layout from '../layouts/Layout.astro';
import { RESUME_PATH, configuredUrl, PERSONAL_LINKEDIN_URL, PERSONAL_GITHUB_URL } from '../data/links';
const profiles = [{label:'LinkedIn',url:configuredUrl(PERSONAL_LINKEDIN_URL)},{label:'GitHub',url:configuredUrl(PERSONAL_GITHUB_URL)}].filter(profile => profile.url);
const base=import.meta.env.BASE_URL;
---
<Layout title="About"><header class="wrap page-intro"><h1 class="eyebrow" style="color: var(--accent)">Rhan Chen / Xinran Chen</h1></header><section class="wrap about-layout"><figure><img src={`${base}images/about-red-lit-performance.jpg`} alt="Musicians performing with pipa and electric guitars under red stage lighting." width="1800" height="1350"/></figure><div class="prose"><h2>Music comes first.</h2><p>I’m Rhan Chen (Xinran Chen), a Toronto-based music technology graduate, musician, mastering engineer and creative production professional with a background in computer science.</p><p>My experience spans mastering, recording, pipa and bass performance, concert organization, live audiovisual production, audio signal processing and machine learning research. I’m interested in the connections between the creative work, the people who make it happen and the technology supporting it.</p><p>I’m pursuing opportunities in music coordination, label and artist services, recording, and creative production, alongside audio engineering and technical development.</p><h2>Education</h2><p><strong>New York University</strong><br/>M.S. in Music Technology<br/>B.M. in Music Technology and Computer Science (double major)</p><h2>Creative & technical practice</h2><ul><li>Mastering, recording and audio production</li><li>Pipa and bass guitar performance</li><li>Event coordination, music programming and concert production</li><li>Team leadership, communication and collaboration</li><li>Live audiovisual technical support</li><li>Audio signal processing, machine learning and software development</li></ul><h2>Selected experience</h2><p>Band member of Hang Him to the Scales; co-founder and president of NYU’s Chinese Traditional Music Club; recording studio engineering and audiovisual technical support at NYU.</p>{(RESUME_PATH || profiles.length > 0) && <><h2>Résumé & links</h2>{RESUME_PATH && <p><a class="text-link" href={base+RESUME_PATH} download>Download résumé PDF ↓</a></p>}{profiles.map(profile => <p><a class="text-link" href={profile.url} target="_blank" rel="noopener noreferrer">{profile.label} ↗</a></p>)}</>}<a class="text-link" href={`${base}contact/`}>Contact details ↗</a></div></section></Layout>
